# 1. 가상환경 및 환경설정
venv/
.env
*.env

# 2. 결과물 및 데이터 (클라우드 배포를 위해 csv, html, png는 포함)
outputs/*
!outputs/.gitkeep
!outputs/**/*.csv
!outputs/**/*.html
!outputs/**/*.png
experiments/*
!experiments/.gitkeep

# 3. 파이썬 캐시 및 체크포인트
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/

# 4. 대용량 모델 파일 (필요 시 주석 해제)
*.pkl
*.h5
*.pt
*.pth

# 5. OS 생성 파일
.DS_Store
Thumbs.db
